# Local LLM through Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
REQUIRE_LOCAL_LLM=true

# Strict local-only blocks all external API calls.
# Set false to allow safe metadata API calls while keeping the LLM local.
STRICT_LOCAL_ONLY_MODE=false

# External similarity APIs
ALLOW_EXTERNAL_SIMILARITY_QUERIES=true
SEND_ONLY_SAFE_QUERY_TERMS=true

# EPO Open Patent Services
EPO_OPS_CONSUMER_KEY=replace_with_your_epo_consumer_key
EPO_OPS_CONSUMER_SECRET=replace_with_your_epo_consumer_secret
EPO_OPS_AUTH_URL=https://ops.epo.org/3.2/auth/accesstoken
EPO_OPS_SERVICE_BASE_URL=https://ops.epo.org

# Lens Scholarly API
LENS_API_TOKEN=replace_with_your_lens_api_token
LENS_API_BASE_URL=https://api.lens.org/scholarly/search

# Lens Scholarly API
LENS_API_TOKEN=replace_with_your_lens_api_token
LENS_API_BASE_URL=https://api.lens.org/scholarly/search

# NIHR Open Data
NIHR_OPEN_DATA_BASE_URL=https://nihr.opendatasoft.com/api/explore/v2.1
NIHR_OPEN_DATA_DATASET_ID=infonihr-open-dataset
NIHR_OPEN_DATA_API_KEY=

# App storage/developer controls
SAVE_UPLOADS=false
MOCK_SIMILARITY_MODE=false
